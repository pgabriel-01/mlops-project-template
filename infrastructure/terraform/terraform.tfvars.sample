location       = "eastus2"
prefix         = "taxi"
postfix        = "10001"
project_number = "001"
environment    = "dev"

enable_aml_computecluster = true
aml_compute_sku           = "STANDARD_D2S_V3"
enable_monitoring         = true

# Set this to the object ID of the Azure DevOps workload identity service
# principal when Terraform should grant CI/CD access to AML and storage.
cicd_principal_object_id = ""

# Keep public access for the initial DEV deployment. Enabling private endpoints
# requires private DNS and a network-reachable Azure DevOps agent.
enable_private_endpoints          = false
vnet_address_space                = "10.0.0.0/16"
training_subnet_address_prefix    = "10.0.0.0/24"
endpoints_subnet_address_prefix   = "10.0.1.0/24"
